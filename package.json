    "client": "cd frontend && npm start",
    "build": "echo 'Frontend deployed separately on Cloudflare Pages — skipping build'",
    "install-all": "npm install && cd frontend && npm install",
    "turnon": "concurrently \"npm run server\" \"npm run client\""
